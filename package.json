    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "embedded-postgres": "^18.6.0-beta.19",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "pg-server": "^0.1.8",

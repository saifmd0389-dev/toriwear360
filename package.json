{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "start": "node code.js",
    "preview": "vite preview",
    "seed": "tsx server/db/seed.ts",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@google-cloud/storage": "^9.0.0",
    "@google/genai": "^2.4.0",

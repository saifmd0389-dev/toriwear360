# ==============================================================================
# TORIWEAR PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT put real secrets into this example file.
# Server secrets must never be exposed through Vite / client frontend variables.
# ==============================================================================

# Database Architecture (PostgreSQL / Prisma ORM)
DATABASE_URL="postgresql://username:password@localhost:5432/toriwear?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://username:password@localhost:5432/toriwear?schema=public"

# Session & Security Tokens
TORI_INITIAL_ADMIN_PASSWORD="set-a-unique-random-password-at-least-16-characters"
TORI_BOOTSTRAP_ADMIN_PASSWORD="set-a-different-unique-random-password-at-least-16-characters"
SESSION_SECRET="your_cryptographically_secure_session_secret_min_32_chars"
TWO_FACTOR_ENCRYPTION_KEY="32_byte_hex_key_for_aes_256_gcm_totp_encryption"

# Application Deployment URL
APP_URL="MY_APP_URL"

# Gemini AI (Lore, Story & Narrative Generation)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_TEXT_MODEL="gemini-3.8-flash"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# AI Image Generation Configuration (Feature Flag & Provider Abstraction)
# When AI_IMAGE_ENABLED=false, the AI Design Lab operates without requiring image API keys.
AI_IMAGE_ENABLED="false"
AI_IMAGE_PROVIDER="none"
AI_IMAGE_API_KEY=""
AI_IMAGE_MODEL=""

# Firebase Configuration (Customer Google OAuth)
# Currently retained strictly for storefront customer Google authentication
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN="tori-wear.firebaseapp.com"
FIREBASE_PROJECT_ID="tori-wear"
FIREBASE_STORAGE_BUCKET="tori-wear.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="587721360987"
FIREBASE_APP_ID="1:587721360987:web:ddfe0f56d9dc9db8a8217e"

# Payment Gateway Configuration (Future Production Activation)
# Note: In Phase 1, payments operate in DEMO/SIMULATED SANDBOX mode
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email Communication Configuration (Future Production Activation)
# Supported providers: "sendgrid" | "resend" | "postmark" | "smtp"
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="orders@toriwear.com"

# SMS / Mobile OTP Provider Configuration (Future Production Activation)
# Supported providers: "msg91" | "twilio" | "fast2sms"
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# ==============================================================================
# SECURE PRIVATE ADMIN OPERATIONS GATEWAY
# ==============================================================================
# Configurable, non-obvious route for staff authentication and business operations.
# Public customers visit https://thetoriwearstore.in directly without exposed admin links.
VITE_ADMIN_PATH="/tori-ops-gateway"

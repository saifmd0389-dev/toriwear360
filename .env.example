# ==============================================================================
# TORIWEAR PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT put real secrets into this example file.
# Server secrets must never be exposed through Vite / client frontend variables.
# ==============================================================================

# Database Architecture (GoDaddy Hosted MySQL / Prisma ORM)
DB_HOST="<from-hosting>"
DB_PORT="3306"
DB_NAME="<from-hosting>"
DB_USER="<from-hosting>"
DB_PASSWORD="<from-hosting>"
# Set DB_SSL="true" if GoDaddy MySQL requires TLS
DB_SSL="false"
# Direct MySQL connection strings (used if discrete DB_* vars are not provided, and required by Prisma CLI)
DATABASE_URL="mysql://username:password@host:3306/toriwear"
# Optional direct connection URL for migrations
DIRECT_URL="mysql://username:password@host:3306/toriwear"

# Session & Security Tokens
TORI_INITIAL_ADMIN_PASSWORD="set-a-unique-random-password-at-least-16-characters"
TORI_BOOTSTRAP_ADMIN_PASSWORD="set-a-different-unique-random-password-at-least-16-characters"
SESSION_SECRET="your_cryptographically_secure_session_secret_min_32_chars"
TWO_FACTOR_ENCRYPTION_KEY="32_byte_hex_key_for_aes_256_gcm_totp_encryption"
# Dedicated HMAC secret for Early Access one-click signed unsubscribe URLs (defaults to SESSION_SECRET if omitted)
UNSUBSCRIBE_TOKEN_SECRET="your_cryptographically_secure_unsubscribe_secret"

# Application Deployment URL (used for Resend unsubscribe links & email CTAs)
APP_URL="https://thetoriwearstore.in"

# Gemini AI (Lore, Story & Narrative Generation)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_TEXT_MODEL="gemini-3.8-flash"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# AI Image Generation Configuration (Feature Flag & Provider Abstraction)
# When AI_IMAGE_ENABLED=false, the AI Design Lab operates without requiring image API keys.
AI_IMAGE_ENABLED="false"
AI_IMAGE_PROVIDER="none"
AI_IMAGE_API_KEY=""
AI_IMAGE_MODEL=""

# Firebase Configuration (Customer Google OAuth)
# Currently retained strictly for storefront customer Google authentication
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN="tori-wear.firebaseapp.com"
FIREBASE_PROJECT_ID="tori-wear"
FIREBASE_STORAGE_BUCKET="tori-wear.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="587721360987"
FIREBASE_APP_ID="1:587721360987:web:ddfe0f56d9dc9db8a8217e"

# Payment Gateway Configuration (Future Production Activation)
# Note: In Phase 1, payments operate in DEMO/SIMULATED SANDBOX mode
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email Communication Configuration (Resend Integration)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
# Fallback alias also supported: EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="TORIWEAR <drops@thetoriwearstore.in>"
EMAIL_REPLY_TO="support@thetoriwearstore.in"
# Resend Svix webhook signing secret (whsec_...) for POST /api/v1/webhooks/resend
EMAIL_WEBHOOK_SECRET=""

# Official Meta WhatsApp Business Cloud API Integration
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_TEMPLATE_NAME="toriwear_drop_launch"
WHATSAPP_CONFIRM_TEMPLATE_NAME="toriwear_early_access_confirm"
WHATSAPP_TEMPLATE_LANG="en"
# Webhook verify token (GET /api/v1/webhooks/whatsapp) and Meta App Secret for X-Hub-Signature-256 (POST)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# SMS / Mobile OTP Provider Configuration (Future Production Activation)
# Supported providers: "msg91" | "twilio" | "fast2sms"
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# ==============================================================================
# SECURE PRIVATE ADMIN OPERATIONS GATEWAY
# ==============================================================================
# Configurable, non-obvious route for staff authentication and business operations.
# Public customers visit https://thetoriwearstore.in directly without exposed admin links.
VITE_ADMIN_PATH="/tori-ops-gateway"

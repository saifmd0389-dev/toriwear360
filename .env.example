# ==============================================================================
# TORIWEAR PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT put real secrets into this example file.
# Server secrets must never be exposed through Vite / client frontend variables.
# ==============================================================================

# Database Architecture (GoDaddy Hosted MySQL / Prisma ORM)
DB_HOST="<from-hosting>"
DB_PORT="3306"
DB_NAME="<from-hosting>"
DB_USER="<from-hosting>"
DB_PASSWORD="<from-hosting>"
# Set DB_SSL="true" if GoDaddy MySQL requires TLS
DB_SSL="false"
# Direct MySQL connection strings (used if discrete DB_* vars are not provided, and required by Prisma CLI)
DATABASE_URL="mysql://username:password@host:3306/toriwear"
# Optional direct connection URL for migrations
DIRECT_URL="mysql://username:password@host:3306/toriwear"

# Session & Security Tokens
TORI_INITIAL_ADMIN_PASSWORD="set-a-unique-random-password-at-least-16-characters"
TORI_BOOTSTRAP_ADMIN_PASSWORD="set-a-different-unique-random-password-at-least-16-characters"
SESSION_SECRET="your_cryptographically_secure_session_secret_min_32_chars"
TWO_FACTOR_ENCRYPTION_KEY="32_byte_hex_key_for_aes_256_gcm_totp_encryption"
# Dedicated HMAC secret for Early Access one-click signed unsubscribe URLs (defaults to SESSION_SECRET if omitted)
UNSUBSCRIBE_TOKEN_SECRET="your_cryptographically_secure_unsubscribe_secret"

# Application Server Port & Canonical Site URL (GoDaddy Hosting Compatible)
PORT="3000"
SITE_URL="https://thetoriwearstore.in"
APP_URL="https://thetoriwearstore.in"

# Gemini AI (Lore, Story & Narrative Generation)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_TEXT_MODEL="gemini-3.8-flash"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# AI Image Generation Configuration (Feature Flag & Provider Abstraction)
# When AI_IMAGE_ENABLED=false, the AI Design Lab operates without requiring image API keys.
AI_IMAGE_ENABLED="false"
AI_IMAGE_PROVIDER="none"
AI_IMAGE_API_KEY=""
AI_IMAGE_MODEL=""

# Firebase Configuration (Customer Google OAuth)
# Both server-side FIREBASE_* and client-build VITE_FIREBASE_* keys supported (no secrets exposed)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN="tori-wear.firebaseapp.com"
FIREBASE_PROJECT_ID="tori-wear"
FIREBASE_STORAGE_BUCKET="tori-wear.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="587721360987"
FIREBASE_APP_ID="1:587721360987:web:ddfe0f56d9dc9db8a8217e"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="tori-wear.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tori-wear"

# Meta Business & Conversions API (Server-Only Secret)
# Pixel ID & Domain Verification Code are managed via Admin Settings (never hardcoded secrets)
META_CONVERSIONS_API_TOKEN=""

# Payment Gateway Configuration (Razorpay Live / Test Keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email Communication Configuration (Resend Integration)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
# Fallback alias also supported: EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="TORIWEAR <drops@thetoriwearstore.in>"
EMAIL_REPLY_TO="support@thetoriwearstore.in"
# Resend Svix webhook signing secret (whsec_...) for POST /api/v1/webhooks/resend
EMAIL_WEBHOOK_SECRET=""

# Official Meta WhatsApp Business Cloud API Integration
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_TEMPLATE_NAME="toriwear_drop_launch"
WHATSAPP_CONFIRM_TEMPLATE_NAME="toriwear_early_access_confirm"
WHATSAPP_TEMPLATE_LANG="en"
# Webhook verify token (GET /api/v1/webhooks/whatsapp) and Meta App Secret for X-Hub-Signature-256 (POST)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# SMS / Mobile OTP Provider Configuration (Future Production Activation)
# Supported providers: "msg91" | "twilio" | "fast2sms"
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# ==============================================================================
# MEDIA STORAGE & IMAGE OPTIMIZATION (SERVER-SIDE ONLY)
# ==============================================================================
# Supported values: "local" (default fallback) | "gcs" (Google Cloud Storage) | "r2" (Cloudflare R2)
# Keep "local" until your cloud bucket and credentials are verified.
# Public storefront images (GCS) use Uniform Bucket-Level Access (UBLA) + bucket-level IAM
# (grant roles/storage.objectViewer to allUsers on the dedicated storefront media bucket only;
# never store private customer files or unrelated app data in the public media bucket, and
# do not rely on legacy object ACLs or GCS_MAKE_PUBLIC).
# NEVER prefix GCS or R2 credentials with VITE_ or expose them to browser bundles.
STORAGE_PROVIDER="local"

# Google Cloud Storage (used when STORAGE_PROVIDER="gcs")
GCS_PROJECT_ID="<your-gcp-project-id>"
GCS_BUCKET_NAME="<your-gcs-bucket-name>"
# Option 1: Single-line JSON or base64-encoded service-account key JSON
GCS_SERVICE_ACCOUNT_JSON=""
# Option 2: Separate service-account credential variables (used if GCS_SERVICE_ACCOUNT_JSON is empty)
GCS_CLIENT_EMAIL="<service-account@your-project.iam.gserviceaccount.com>"
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<your-private-key>\n-----END PRIVATE KEY-----\n"
# Optional custom HTTPS public URL prefix (defaults to https://storage.googleapis.com/<GCS_BUCKET_NAME>)
GCS_PUBLIC_URL_PREFIX=""

# Cloudflare R2 S3-Compatible Storage (used when STORAGE_PROVIDER="r2", region="auto")
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# R2 S3 API endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com if omitted)
R2_ENDPOINT=""
# Public HTTPS URL for serving storefront media (e.g. https://pub-<bucket-hash>.r2.dev or custom HTTPS domain)
R2_PUBLIC_URL=""

# Optional max upload size in bytes for chunked image uploads (default: 26214400 = 25 MB)
MAX_IMAGE_UPLOAD_BYTES="26214400"

# Safe Post-Commit Media Cleanup (Server-Side Only, Restart-Safe)
# Optional pending-upload expiry TTL in ms before sweeping abandoned unsaved uploads (default: 3600000 = 60 min)
MEDIA_PENDING_UPLOAD_TTL_MS="3600000"
# Optional safety cooldown in ms before deleting unreferenced catalog media after DB commit (default: 120000 = 2 min)
MEDIA_CLEANUP_COOLDOWN_MS="120000"
# Set to "true" to audit cleanup decisions in server logs without deleting any storage objects
MEDIA_CLEANUP_DRY_RUN="false"

# ==============================================================================
# SECURE PRIVATE ADMIN OPERATIONS GATEWAY
# ==============================================================================
# Configurable, non-obvious route for staff authentication and business operations.
# Public customers visit https://thetoriwearstore.in directly without exposed admin links.
VITE_ADMIN_PATH="/tori-ops-gateway"

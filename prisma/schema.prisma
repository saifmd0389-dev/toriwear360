model FinancialAccount {
  id               String                 @id @default(cuid())
  accountName      String
  accountType      String                 @default("BANK") // BANK, GATEWAY, CASH, WALLET
  accountNumber    String?
  ifscOrRouting    String?
  balance          Float                  @default(0.0)
  currency         String                 @default("INR")
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  transactions     FinancialTransaction[]

  @@map("financial_accounts")
}

model FinancialTransaction {
  id                String            @id @default(cuid())
  accountId         String
  type              String            // INCOME, EXPENSE, TRANSFER
  category          String
  amount            Float
  currency          String            @default("INR")
  referenceType     String?           // ORDER, REFUND, PAYROLL, OPERATIONAL, PARTNER_PAYOUT
  referenceId       String?
  description       String            @db.Text
  performedByUserId String?
  timestamp         DateTime          @default(now())
  createdAt         DateTime          @default(now())

  account           FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  performedByUser   User?             @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([timestamp])
  @@map("financial_transactions")

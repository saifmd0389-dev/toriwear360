enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id                 String         @id @default(cuid())
  code               String         @unique
  description        String?        @db.Text
  discountType       DiscountType   @default(PERCENTAGE)
  value              Float
  minOrderValue      Float          @default(0.0)
  maxDiscount        Float?
  usageLimit         Int?
  usageCount         Int            @default(0)
  perUserLimit       Int            @default(1)
  eligibleCategories String?        @db.Text
  eligibleProductIds String?        @db.Text
  excludeShipping    Boolean        @default(true)
  excludeTax         Boolean        @default(true)
  isActive           Boolean        @default(true)
  startsAt           DateTime       @default(now())
  expiresAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  usages             CouponUsage[]

  @@index([code])
  @@map("coupons")
}

model CouponUsage {
  id             String    @id @default(cuid())
  couponId       String
  orderId        String
  customerId     String?
  customerEmail  String?
  customerPhone  String?

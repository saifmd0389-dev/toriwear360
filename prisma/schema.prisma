datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// 1. USERS, ROLES & SECURITY
// ============================================================================

enum UserRoleType {
  SUPER_ADMIN
  PARTNER
  STORE_MANAGER
  INVENTORY_MANAGER
  FULFILLMENT_STAFF
  DESIGNER
  SUPPORT_STAFF
  VIEWER
}

enum AccountStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
  LOCKED
}

enum SeverityLevel {
  INFO
  WARNING
  CRITICAL
}

enum DepartmentType {
  ALL
  MEN
  KIDS
  UNISEX
}

model User {
  id                             String         @id @default(cuid())
  email                          String         @unique
  passwordHash                   String
  salt                           String
  name                           String
  avatarUrl                      String?        @db.Text
  role                           UserRoleType   @default(STORE_MANAGER)
  department                     String?
  employeeId                     String?        @unique
  isActive                       Boolean        @default(true)
  accountStatus                  AccountStatus  @default(ACTIVE)
  mustChangePasswordOnFirstLogin Boolean        @default(false)
  failedLoginAttempts            Int            @default(0)
  lockoutUntil                   DateTime?
  lastPasswordChange             DateTime       @default(now())
  lastLoginAt                    DateTime?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt

  staffProfile                   Staff?
  partnerProfile                 Partner?
  userRoles                      UserRole[]
  sessions                       Session[]
  passwordResetTokens            PasswordResetToken[]
  twoFactorSetting               TwoFactorSetting?
  auditLogs                      AuditLog[]
  inventoryMovements             InventoryMovement[]
  orderStatusHistory             OrderStatusHistory[]
  createdAiDesigns               AIDesign[]
  createdAiVersions              AIDesignVersion[]
  approvedExpenses               Expense[]
  financialTransactions          FinancialTransaction[]

  @@index([email])
  @@index([role])
  @@index([accountStatus])
  @@map("users")
}

model Customer {
  id               String          @id @default(cuid())
  email            String?         @unique
  phone            String?         @unique
  name             String?
  avatarUrl        String?         @db.Text
  firebaseUid      String?         @unique
  isGuest          Boolean         @default(false)
  status           AccountStatus   @default(ACTIVE)
  toriCredit       Int             @default(0)
  insiderTier      String          @default("Bronze")
  insiderPoints    Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  profile          CustomerProfile?
  addresses        CustomerAddress[]
  preferences      CustomerPreference?
  sessions         Session[]
  carts            Cart[]
  wishlists        Wishlist[]
  orders           Order[]
  couponUsages     CouponUsage[]
  reviews          Review[]

  @@index([email])
  @@index([phone])
  @@index([firebaseUid])
  @@map("customers")
}

model Staff {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  department         String
  designation        String
  employeeNumber     String?   @unique
  directReports      String?   @db.Text
  permissionsSummary String?   @db.Text
  joinedAt           DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("staff")
}

model Partner {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerTier            String    @default("EQUITY_PARTNER")
  equityPercentage       Float     @default(0.0)
  profitSharePercentage  Float     @default(0.0)
  votingRights           Boolean   @default(true)
  directDial             String?
  businessAddress        String?
  panNumber              String?
  gstNumber              String?
  bankAccountVerified    Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  partnerAccounts        PartnerAccount[]

  @@map("partners")
}

model Role {
  id               String           @id @default(cuid())
  name             String           @unique
  description      String?          @db.Text
  isSystem         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@map("roles")
}

model Permission {
  id               String           @id @default(cuid())
  code             String           @unique
  module           String
  description      String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  rolePermissions  RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String      @id @default(cuid())
  roleId       String
  permissionId String
  assignedAt   DateTime    @default(now())

  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String    @id @default(cuid())
  token        String    @unique
  userId       String?
  customerId   String?
  ipAddress    String?
  userAgent    String?   @db.Text
  device       String?
  browser      String?
  location     String?
  expiresAt    DateTime
  isValid      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())

  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([customerId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  email     String
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String
  expiresAt  DateTime
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([email])
  @@map("email_verification_tokens")
}

model OtpVerification {
  id           String    @id @default(cuid())
  phoneOrEmail String
  otpHash      String
  purpose      String    @default("LOGIN") // LOGIN, TRANSACTION, PASSWORD_RESET
  attempts     Int       @default(0)
  expiresAt    DateTime
  verified     Boolean   @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([phoneOrEmail])
  @@map("otp_verifications")
}

model TwoFactorSetting {
  id               String    @id @default(cuid())
  userId           String    @unique
  isEnabled        Boolean   @default(false)
  secret           String?   @db.Text // AES-256-GCM encrypted TOTP secret
  pendingSecret    String?   @db.Text // AES-256-GCM encrypted pending secret during enrollment
  pendingExpiresAt DateTime? // Expiration for pending enrollment
  lastAcceptedStep BigInt?   // RFC 6238 time step for cross-process replay prevention
  backupCodes      String?   @db.Text // JSON string of hashed backup codes
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_settings")
}

model AuditLog {
  id             String         @id @default(cuid())
  userId         String?
  userName       String?
  userRole       String?
  module         String
  action         String
  recordAffected String?
  oldValue       String?        @db.Text
  newValue       String?        @db.Text
  ipAddress      String?
  userAgent      String?        @db.Text
  severity       SeverityLevel  @default(INFO)
  timestamp      DateTime       @default(now())
  createdAt      DateTime       @default(now())

  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================================================
// 2. CUSTOMER PROFILES & ADDRESSES
// ============================================================================

model CustomerProfile {
  id                String    @id @default(cuid())
  customerId        String    @unique
  dateOfBirth       DateTime?
  gender            String?
  alternatePhone    String?
  companyName       String?
  notes             String?   @db.Text
  tags              String?   @db.Text // JSON array string
  segment           String    @default("New Customers")
  totalOrders       Int       @default(0)
  totalSpent        Float     @default(0.0)
  averageOrderValue Float     @default(0.0)
  lastOrderDate     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model CustomerAddress {
  id           String    @id @default(cuid())
  customerId   String
  type         String    @default("SHIPPING") // SHIPPING, BILLING, BOTH
  label        String?   // Home, Office, Studio
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String    @default("India")
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerPreference {
  id                    String    @id @default(cuid())
  customerId            String    @unique
  emailMarketing        Boolean   @default(true)
  smsMarketing          Boolean   @default(true)
  whatsappNotifications Boolean   @default(true)
  dropAlerts            Boolean   @default(true)
  preferredDepartment   String?
  preferredSizes        String?   @db.Text // JSON array
  preferredFits         String?   @db.Text // JSON array
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

// ============================================================================
// 3. CATALOG & PRODUCTS
// ============================================================================

enum PublishingStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Category {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  department     DepartmentType @default(MEN)
  parentId       String?
  description    String?        @db.Text
  image          String?        @db.Text
  bannerImage    String?        @db.Text
  seoTitle       String?
  seoDescription String?        @db.Text
  displayOrder   Int            @default(0)
  isActive       Boolean        @default(true)
  showInNav      Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  parent        Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[]     @relation("CategoryHierarchy")
  subcategories Subcategory[]
  products      Product[]

  @@index([slug])
  @@index([department])
  @@index([parentId])
  @@map("categories")
}

model Subcategory {
  id           String    @id @default(cuid())
  categoryId   String
  name         String
  slug         String    @unique
  description  String?   @db.Text
  image        String?   @db.Text
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([categoryId])
  @@index([slug])
  @@map("subcategories")
}

model Product {
  id               String            @id @default(cuid())
  catalogNumber    String            @unique
  name             String
  slug             String            @unique
  department       DepartmentType    @default(MEN)
  world            String            // DARK SHONEN, CYBERPUNK / NEO TOKYO, RETRO Y2K, etc.
  franchise        String
  universe         String            @default("TORI")
  fit              String            @default("Oversized")
  price            Float
  originalPrice    Float             // MRP
  costPrice        Float?
  gsm              Int               @default(240)
  fabric           String            @default("100% Combed Heavyweight Cotton")
  neck             String            @default("High-Ribbed Crewneck")
  sleeves          String            @default("Drop Shoulder Half Sleeves")
  print            String            @default("High-Density Screen Print")
  description      String            @db.Text
  storyQuote       String?           @db.Text
  drop             String            @default("CHAPTER 01 — ORIGINALS")
  isBestseller     Boolean           @default(false)
  isNewDrop        Boolean           @default(true)
  isTrending       Boolean           @default(false)
  inStock          Boolean           @default(true)
  totalSold        Int               @default(0)
  rating           Float             @default(5.0)
  reviewsCount     Int               @default(0)
  licenseType      String            @default("Original IP")
  publishingStatus PublishingStatus  @default(PUBLISHED)
  categoryId       String?
  categoryIdsJson  String?           @db.Text
  subcategoryId    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory      Subcategory?      @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  images           ProductImage[]
  collections      ProductCollection[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  reviews          Review[]

  @@index([slug])
  @@index([catalogNumber])
  @@index([department])
  @@index([world])
  @@index([publishingStatus])
  @@map("products")
}

model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  sku            String    @unique
  size           String    // S, M, L, XL, XXL, XXXL, 4–5Y, 6–7Y, etc.
  colorName      String    @default("Void Black")
  colorHex       String    @default("#0a0a0c")
  price          Float
  originalPrice  Float
  stock          Int       @default(0)
  reservedStock  Int       @default(0)
  weightGrams    Int       @default(320)
  barcode        String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory?
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  images         ProductImage[]
  stockReservations StockReservation[]
  inventoryMovements InventoryMovement[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model ProductImage {
  id            String          @id @default(cuid())
  productId     String
  variantId     String?
  url           String          @db.LongText
  altText       String?         @db.Text
  displayOrder  Int             @default(0)
  isPrimary     Boolean         @default(false)
  angle         String          @default("FRONT") // FRONT, BACK, DETAIL, MODEL
  tagTopLeft    String?
  tagBottomLeft String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_images")
}

model ProductTag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  @@map("product_tags")
}

model Collection {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  subtitle     String?             @db.Text
  description  String?             @db.Text
  bannerImage  String?             @db.Text
  heroImage    String?             @db.Text
  season       String?
  isFeatured   Boolean             @default(false)
  isActive     Boolean             @default(true)
  displayOrder Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  products     ProductCollection[]

  @@index([slug])
  @@map("collections")
}

model ProductCollection {
  id           String     @id @default(cuid())
  productId    String
  collectionId String
  displayOrder Int        @default(0)
  assignedAt   DateTime   @default(now())

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId])
  @@map("product_collections")
}

// ============================================================================
// 4. INVENTORY & STOCK RESERVATIONS
// ============================================================================

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  RELEASED
}

model Inventory {
  id                 String         @id @default(cuid())
  variantId          String         @unique
  warehouseLocation  String         @default("MAIN_MUMBAI")
  quantityOnHand     Int            @default(0)
  quantityReserved   Int            @default(0)
  quantityAvailable  Int            @default(0)
  safetyStock        Int            @default(5)
  reorderPoint       Int            @default(15)
  lastStockAuditAt   DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model InventoryMovement {
  id                 String                @id @default(cuid())
  variantId          String
  movementType       InventoryMovementType
  quantity           Int
  balanceAfter       Int
  referenceType      String?               // ORDER, RETURN, ADMIN_ADJUSTMENT, INITIAL_STOCK
  referenceId        String?
  reason             String?               @db.Text
  performedByUserId  String?
  timestamp          DateTime              @default(now())
  createdAt          DateTime              @default(now())

  variant            ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  performedByUser    User?                 @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([timestamp])
  @@map("inventory_movements")
}

model StockReservation {
  id          String            @id @default(cuid())
  variantId   String
  cartId      String?
  orderId     String?
  quantity    Int               @default(1)
  expiresAt   DateTime
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([cartId])
  @@index([orderId])
  @@index([status])
  @@map("stock_reservations")
}

// ============================================================================
// 5. SHOPPING: CARTS & WISHLISTS
// ============================================================================

model Cart {
  id                 String      @id @default(cuid())
  customerId         String?
  sessionToken       String?     @unique
  currency           String      @default("INR")
  subtotal           Float       @default(0.0)
  discountTotal      Float       @default(0.0)
  appliedCouponCode  String?
  expiresAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  customer           Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items              CartItem[]

  @@index([customerId])
  @@index([sessionToken])
  @@map("carts")
}

model CartItem {
  id         String         @id @default(cuid())
  cartId     String
  variantId  String
  productId  String
  quantity   Int            @default(1)
  unitPrice  Float
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id           String         @id @default(cuid())
  customerId   String?
  sessionToken String?        @unique
  name         String         @default("My Anime Fits")
  isPublic     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items        WishlistItem[]

  @@index([customerId])
  @@index([sessionToken])
  @@map("wishlists")
}

model WishlistItem {
  id         String          @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  addedAt    DateTime        @default(now())

  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ============================================================================
// 6. ORDERS & FULFILLMENT
// ============================================================================

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum OrderShippingStatus {
  CONFIRMED
  PROCESSING
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

model Order {
  id                     String              @id @default(cuid())
  orderNumber            String              @unique
  customerId             String?
  customerEmail          String
  customerPhone          String
  customerName           String
  subtotal               Float
  discount               Float               @default(0.0)
  discountCode           String?
  tax                    Float               @default(0.0)
  shippingFee            Float               @default(0.0)
  codFee                 Float               @default(0.0)
  total                  Float
  currency               String              @default("INR")
  paymentMethod          String              // upi, card, netbanking, cod
  paymentStatus          PaymentStatus       @default(PENDING)
  shippingStatus         OrderShippingStatus @default(CONFIRMED)
  courierPartner         String?             // Shiprocket, Delhivery, BlueDart, DTDC
  courierTrackingNumber  String?
  awbNumber              String?
  orderAccessToken       String?
  idempotencyKey         String?             @unique
  cancellationReason     String?             @db.Text
  cancelledAt            DateTime?
  refundStatus           String?
  refundAmount           Float?
  estimatedDeliveryDate  DateTime?
  deliveryNotes          String?             @db.Text
  isGift                 Boolean             @default(false)
  ipAddress              String?
  userAgent              String?             @db.Text
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  customer               Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  addresses              OrderAddress[]
  statusHistory          OrderStatusHistory[]
  payments               Payment[]
  shipments              Shipment[]
  couponUsages           CouponUsage[]
  returnRequests         ReturnRequest[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([shippingStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  productId     String
  variantId     String?
  productName   String
  productSku    String
  size          String
  color         String
  image         String?         @db.Text
  quantity      Int             @default(1)
  unitPrice     Float
  totalPrice    Float
  discount      Float           @default(0.0)
  tax           Float           @default(0.0)
  returnStatus  String?         // NONE, REQUESTED, APPROVED, PICKED_UP, REFUNDED
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderAddress {
  id           String    @id @default(cuid())
  orderId      String
  type         String    @default("SHIPPING") // SHIPPING, BILLING
  fullName     String
  phone        String
  email        String?
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String    @default("India")

model AIDesign {
  id                 String             @id @default(cuid())
  designNumber       String             @unique
  name               String
  prompt             String             @db.Text
  originalPrompt     String?            @db.Text
  negativePrompt     String?            @db.Text
  department         DepartmentType     @default(MEN)
  world              String
  collection         String?
  characterName      String?
  designType         String
  placement          String
  mood               String
  colorDirection     String

  @@map("order_addresses")
}

model OrderStatusHistory {
  id              String              @id @default(cuid())
  orderId         String
  fromStatus      OrderShippingStatus?
  toStatus        OrderShippingStatus
  note            String?             @db.Text
  updatedByUserId String?

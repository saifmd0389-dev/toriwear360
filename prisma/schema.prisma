  displayOrder   Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime  @default(now())
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("banners")
}

model PromotionalCampaign {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique

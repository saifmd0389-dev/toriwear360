model IncomeRecord {
  id         String   @id @default(cuid())
  source     String   @default("ONLINE_ORDERS")
  amount     Float
  currency   String   @default("INR")
  orderId    String?
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([receivedAt])
  @@map("income_records")
}

model PartnerAccount {
  id                  String    @id @default(cuid())
  partnerId           String
  totalEarnings       Float     @default(0.0)
  totalPaid           Float     @default(0.0)
  pendingBalance      Float     @default(0.0)
  lastPayoutAt        DateTime?
  bankDetailsVerified Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  partner             Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_accounts")
}

// ============================================================================
// 14. EARLY ACCESS REGISTRATION & NOTIFICATION DISPATCH
// ============================================================================

enum EarlyAccessStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  BLOCKED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  BOTH
}

enum DeliveryChannel {
  EMAIL
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  CONFIRMED
  SENDING
  COMPLETED
  PARTIAL_FAILURE
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

model EarlyAccessSubscriber {
  id                   String                 @id @default(cuid())
  email                String?                @unique
  whatsappNumber       String?                @unique
  preferredChannel     NotificationChannel    @default(EMAIL)
  emailConsent         Boolean                @default(false)
  emailConsentAt       DateTime?
  whatsappConsent      Boolean                @default(false)
  whatsappConsentAt    DateTime?
  registrationSource   String                 @default("MAINTENANCE_SCREEN")
  status               EarlyAccessStatus      @default(ACTIVE)
  unsubscribeTokenHash String?                @unique
  unsubscribedAt       DateTime?
  unsubscribeReason    String?                @db.Text
  couponCode           String?
  couponEligible       Boolean                @default(false)
  couponRedeemedAt     DateTime?
  lastNotifiedAt       DateTime?
  metadataJson         String?                @db.Text
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  deliveries           NotificationDelivery[]

  @@index([status])
  @@index([preferredChannel])
  @@index([createdAt])
  @@map("early_access_subscribers")
}

model NotificationCampaign {
  id                    String                 @id @default(cuid())
  name                  String
  campaignType          String                 @default("LAUNCH_ANNOUNCEMENT")
  subject               String?
  emailHtml             String?                @db.LongText
  emailText             String?                @db.Text
  whatsappTemplateName  String?
  whatsappTemplateLang  String?
  whatsappVariablesJson String?                @db.Text
  channels              NotificationChannel    @default(BOTH)
  status                CampaignStatus         @default(DRAFT)
  recipientCount        Int                    @default(0)
  sentCount             Int                    @default(0)
  deliveredCount        Int                    @default(0)
  failedCount           Int                    @default(0)
  createdByUserId       String?
  confirmedByUserId     String?
  confirmedAt           DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  deliveries            NotificationDelivery[]

  @@index([status])
  @@index([createdAt])
  @@map("notification_campaigns")
}

model NotificationDelivery {
  id                   String                @id @default(cuid())
  subscriberId         String
  campaignId           String?
  eventType            String                @default("LAUNCH_ANNOUNCEMENT")
  channel              DeliveryChannel
  recipientMask        String
  providerName         String
  providerMessageId    String?
  idempotencyKey       String                @unique
  status               DeliveryStatus        @default(PENDING)
  attemptCount         Int                   @default(0)
  lastAttemptAt        DateTime?
  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?
  failureReason        String?               @db.Text
  providerResponseJson String?               @db.Text
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  subscriber           EarlyAccessSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  campaign             NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([campaignId, subscriberId, channel])
  @@index([providerMessageId])
  @@index([status])
  @@index([subscriberId])
  @@index([campaignId])
  @@map("notification_deliveries")
}

// ============================================================================
// 15. CUSTOMER RETURNS & RAZORPAY REFUNDS
// ============================================================================

enum ReturnRequestStatus {
  RETURN_REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  IN_TRANSIT
  RETURNED_TO_WAREHOUSE
  REFUND_PROCESSING
  REFUNDED
  CLOSED
}

model ReturnRequest {
  id                  String                @id @default(cuid())
  returnNumber        String                @unique
  orderId             String
  orderNumber         String
  customerId          String?
  customerName        String
  customerEmail       String
  customerPhone       String
  requestType         String                @default("RETURN") // RETURN | EXCHANGE
  reason              String
  comments            String?               @db.Text
  proofFilesJson      String?               @db.Text
  status              ReturnRequestStatus   @default(RETURN_REQUESTED)
  rejectionReason     String?               @db.Text
  courierPartner      String?
  awbNumber           String?
  pickupScheduledAt   DateTime?
  receivedAt          DateTime?
  restockedAt         DateTime?
  refundAmount        Float                 @default(0.0)
  refundMethod        String?               // RAZORPAY | BANK_UPI_MANUAL | TORI_CREDIT | EXCHANGE
  refundId            String?
  refundStatus        String?
  refundReference     String?
  refundedAt          DateTime?
  adminNotes          String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items               ReturnItem[]
  history             ReturnStatusHistory[]

  @@index([orderId])
  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@map("return_requests")
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  orderItemId     String
  productId       String
  variantId       String?
  productName     String
  sku             String?
  size            String
  color           String?
  quantity        Int           @default(1)
  unitPrice       Float
  refundAmount    Float
  restocked       Boolean       @default(false)
  restockedAt     DateTime?

  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@index([orderItemId])
  @@map("return_items")
}

model ReturnStatusHistory {
  id              String        @id @default(cuid())
  returnRequestId String
  fromStatus      String?
  toStatus        String
  note            String?       @db.Text
  actorId         String?
  actorName       String?
  actorRole       String?
  createdAt       DateTime      @default(now())

  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@map("return_status_history")
}


